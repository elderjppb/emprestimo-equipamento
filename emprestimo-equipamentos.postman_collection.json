{
  "info": {
    "name": "Empréstimo de Equipamentos",
    "description": "Endpoints e cenários de teste do sistema de empréstimo de equipamentos. Todas as requisições passam pela API Gateway. Execute as pastas na ordem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:8080" },
    { "key": "idInexistente", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "usuarioId", "value": "" },
    { "key": "equipamentoId", "value": "" },
    { "key": "emprestimoId", "value": "" },
    { "key": "email", "value": "" },
    { "key": "matricula", "value": "" },
    { "key": "patrimonio", "value": "" },
    { "key": "reservaId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Usuários",
      "item": [
        {
          "name": "Criar usuário",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const sufixo = Date.now();",
                  "pm.collectionVariables.set('email', `ana.${sufixo}@escola.edu`);",
                  "pm.collectionVariables.set('matricula', `MAT${sufixo}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('usuarioId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Ana Souza\",\n  \"email\": \"{{email}}\",\n  \"matricula\": \"{{matricula}}\"\n}" },
            "url": "{{gateway}}/api/v1/usuarios"
          }
        },
        {
          "name": "Consultar usuário por ID",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/usuarios/{{usuarioId}}" }
        },
        {
          "name": "E-mail duplicado (409)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Outro Usuário\",\n  \"email\": \"{{email}}\",\n  \"matricula\": \"OUTRA-MAT\"\n}" },
            "url": "{{gateway}}/api/v1/usuarios"
          }
        },
        {
          "name": "Matrícula duplicada (409)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Outro Usuário\",\n  \"email\": \"outro.{{matricula}}@escola.edu\",\n  \"matricula\": \"{{matricula}}\"\n}" },
            "url": "{{gateway}}/api/v1/usuarios"
          }
        },
        {
          "name": "Dados inválidos (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"\",\n  \"email\": \"email-invalido\",\n  \"matricula\": \"\"\n}" },
            "url": "{{gateway}}/api/v1/usuarios"
          }
        },
        {
          "name": "JSON inválido (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"nome\": " },
            "url": "{{gateway}}/api/v1/usuarios"
          }
        },
        {
          "name": "ID mal formatado (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/usuarios/abc" }
        },
        {
          "name": "Usuário inexistente (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/usuarios/{{idInexistente}}" }
        }
      ]
    },
    {
      "name": "2. Equipamentos",
      "item": [
        {
          "name": "Criar equipamento",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('patrimonio', `PAT-${Date.now()}`);"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Nasce disponível', () => pm.expect(pm.response.json().disponivel).to.eql(true));",
                  "pm.collectionVariables.set('equipamentoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Notebook Dell Latitude\",\n  \"tipo\": \"NOTEBOOK\",\n  \"patrimonio\": \"{{patrimonio}}\"\n}" },
            "url": "{{gateway}}/api/v1/equipamentos"
          }
        },
        {
          "name": "Consultar equipamento por ID",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}" }
        },
        {
          "name": "Listar equipamentos disponíveis",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Contém o equipamento criado', () => pm.expect(pm.response.json().map(e => e.id)).to.include(pm.collectionVariables.get('equipamentoId')));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/equipamentos/disponiveis" }
        },
        {
          "name": "Patrimônio duplicado (409)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Tablet Samsung\",\n  \"tipo\": \"TABLET\",\n  \"patrimonio\": \"{{patrimonio}}\"\n}" },
            "url": "{{gateway}}/api/v1/equipamentos"
          }
        },
        {
          "name": "Dados inválidos (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"\",\n  \"tipo\": \"\",\n  \"patrimonio\": \"\"\n}" },
            "url": "{{gateway}}/api/v1/equipamentos"
          }
        },
        {
          "name": "Equipamento inexistente (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/equipamentos/{{idInexistente}}" }
        }
      ]
    },
    {
      "name": "3. Empréstimos",
      "item": [
        {
          "name": "Solicitar empréstimo (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Status ATIVO', () => pm.expect(pm.response.json().status).to.eql('ATIVO'));",
                  "pm.collectionVariables.set('emprestimoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": \"{{usuarioId}}\",\n  \"equipamentoId\": \"{{equipamentoId}}\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos"
          }
        },
        {
          "name": "Equipamento indisponível após empréstimo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Indisponível', () => pm.expect(pm.response.json().disponivel).to.eql(false));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}" }
        },
        {
          "name": "Equipamento ocupado (409)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": \"{{usuarioId}}\",\n  \"equipamentoId\": \"{{equipamentoId}}\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos"
          }
        },
        {
          "name": "Usuário inexistente (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": \"{{idInexistente}}\",\n  \"equipamentoId\": \"{{equipamentoId}}\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos"
          }
        },
        {
          "name": "Equipamento inexistente (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": \"{{usuarioId}}\",\n  \"equipamentoId\": \"{{idInexistente}}\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos"
          }
        },
        {
          "name": "Dados inválidos (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{gateway}}/api/v1/emprestimos"
          }
        },
        {
          "name": "Consultar empréstimo por ID",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/emprestimos/{{emprestimoId}}" }
        },
        {
          "name": "Consultar empréstimos do usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Contém o empréstimo', () => pm.expect(pm.response.json().map(e => e.id)).to.include(pm.collectionVariables.get('emprestimoId')));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/emprestimos/usuarios/{{usuarioId}}" }
        },
        {
          "name": "Empréstimo inexistente (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/emprestimos/{{idInexistente}}" }
        },
        {
          "name": "Devolução sem condição (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{gateway}}/api/v1/emprestimos/{{emprestimoId}}/devolucao"
          }
        },
        {
          "name": "Registrar devolução com condição BOM (200) - CT01",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status DEVOLVIDO', () => pm.expect(pm.response.json().status).to.eql('DEVOLVIDO'));",
                  "pm.test('Data de devolução preenchida', () => pm.expect(pm.response.json().dataDevolucao).to.not.be.null);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"condicao\": \"BOM\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos/{{emprestimoId}}/devolucao"
          }
        },
        {
          "name": "Equipamento disponível após devolução",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Disponível', () => pm.expect(pm.response.json().disponivel).to.eql(true));",
                  "pm.test('Condição BOM', () => pm.expect(pm.response.json().condicao).to.eql('BOM'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}" }
        },
        {
          "name": "Devolução repetida (409)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"condicao\": \"AVARIADO\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos/{{emprestimoId}}/devolucao"
          }
        },
        {
          "name": "Devolução de empréstimo inexistente (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"condicao\": \"BOM\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos/{{idInexistente}}/devolucao"
          }
        }
      ]
    },
    {
      "name": "4. Reservas (API interna usada pelo msemprestimo)",
      "item": [
        {
          "name": "Reservar equipamento (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('reservaId', pm.variables.replaceIn('{{$guid}}'));"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Indisponível', () => pm.expect(pm.response.json().disponivel).to.eql(false));"
                ]
              }
            }
          ],
          "request": { "method": "PUT", "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}/reservas/{{reservaId}}" }
        },
        {
          "name": "Repetir a mesma reserva (200, idempotente)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "PUT", "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}/reservas/{{reservaId}}" }
        },
        {
          "name": "Reserva de outro empréstimo (409)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"] } }],
          "request": { "method": "PUT", "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}/reservas/{{idInexistente}}" }
        },
        {
          "name": "Liberar reserva (204)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "DELETE", "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}/reservas/{{reservaId}}" }
        },
        {
          "name": "Repetir a liberação (204, idempotente)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "DELETE", "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}/reservas/{{reservaId}}" }
        },
        {
          "name": "Reservar equipamento inexistente (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "PUT", "url": "{{gateway}}/api/v1/equipamentos/{{idInexistente}}/reservas/{{reservaId}}" }
        }
      ]
    },
    {
      "name": "5. Condição do equipamento e Circuit Breaker (Etapa 2)",
      "item": [
        {
          "name": "Alterar condição (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Condição AVARIADO', () => pm.expect(pm.response.json().condicao).to.eql('AVARIADO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"condicao\": \"AVARIADO\"\n}" },
            "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}/condicao"
          }
        },
        {
          "name": "Alterar condição de equipamento inexistente (404) - CT03",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"condicao\": \"BOM\"\n}" },
            "url": "{{gateway}}/api/v1/equipamentos/{{idInexistente}}/condicao"
          }
        },
        {
          "name": "Condição inválida (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"condicao\": \"QUEBRADO\"\n}" },
            "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}/condicao"
          }
        },
        {
          "name": "Solicitar novo empréstimo (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('emprestimoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": \"{{usuarioId}}\",\n  \"equipamentoId\": \"{{equipamentoId}}\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos"
          }
        },
        {
          "name": "Devolver com condição AVARIADO (200) - CT02",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status DEVOLVIDO', () => pm.expect(pm.response.json().status).to.eql('DEVOLVIDO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"condicao\": \"AVARIADO\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos/{{emprestimoId}}/devolucao"
          }
        },
        {
          "name": "Equipamento AVARIADO e disponível após devolução",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Disponível', () => pm.expect(pm.response.json().disponivel).to.eql(true));",
                  "pm.test('Condição AVARIADO', () => pm.expect(pm.response.json().condicao).to.eql('AVARIADO'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/equipamentos/{{equipamentoId}}" }
        },
        {
          "name": "Solicitar empréstimo para o teste de falha (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('emprestimoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": \"{{usuarioId}}\",\n  \"equipamentoId\": \"{{equipamentoId}}\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos"
          }
        },
        {
          "name": "Devolução com msequipamento desligado (503) - CT04/CT05",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 503', () => pm.response.to.have.status(503));"] } }],
          "request": {
            "description": "Pare o msequipamento antes de enviar. Envie 3 vezes ou mais para abrir o circuito (CT05).",
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"condicao\": \"BOM\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos/{{emprestimoId}}/devolucao"
          }
        },
        {
          "name": "Empréstimo continua ATIVO após falha",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status ATIVO', () => pm.expect(pm.response.json().status).to.eql('ATIVO'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{gateway}}/api/v1/emprestimos/{{emprestimoId}}" }
        },
        {
          "name": "Estado do Circuit Breaker (Actuator)",
          "request": {
            "description": "CLOSED, OPEN ou HALF_OPEN. Após religar o msequipamento e esperar 30s, o estado vai para HALF_OPEN e volta a CLOSED após 2 devoluções com sucesso (CT06).",
            "method": "GET",
            "url": "{{gateway}}/msemprestimo/actuator/circuitbreakers"
          }
        },
        {
          "name": "Devolução após recuperação (200) - CT06",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status DEVOLVIDO', () => pm.expect(pm.response.json().status).to.eql('DEVOLVIDO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"condicao\": \"BOM\"\n}" },
            "url": "{{gateway}}/api/v1/emprestimos/{{emprestimoId}}/devolucao"
          }
        }
      ]
    }
  ]
}
